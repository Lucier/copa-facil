# Copie este arquivo para .env.dev e preencha os valores
# O arquivo .env.dev NÃO deve ser commitado (já está no .gitignore)

# JWT — mínimo 32 chars (use: openssl rand -hex 32)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MinIO (object storage)
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Mercado Pago (sandbox para dev)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Criptografia de dados sensíveis — 64 chars hex (use: openssl rand -hex 32)
ENCRYPTION_KEY=

# CORS (origens permitidas, separadas por vírgula)
# Inclua apenas origens do frontend — NÃO adicione portas de monitoramento (Grafana :3002, Prometheus :9090)
CORS_ORIGINS=http://localhost:3000
